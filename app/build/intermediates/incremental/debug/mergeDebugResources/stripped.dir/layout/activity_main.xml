<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5"
    android:padding="12dp">

    <!-- 頂部標題列與 E-STOP 按鈕 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🤖 Kebbi 多模態情境劇本播放器"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#212121" />

            <TextView
                android:id="@+id/tv_header_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HTTP REST API: Port 8081 | Nuwa Service: 連線中..."
                android:textSize="13sp"
                android:textColor="#757575" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_emergency_stop"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="■ 全域緊急煞停 (E-STOP)"
            android:backgroundTint="#D32F2F"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:paddingStart="20dp"
            android:paddingEnd="20dp" />
    </LinearLayout>

    <!-- 當前執行狀態指示條 -->
    <LinearLayout
        android:id="@+id/layout_status_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#E0F2F1"
        android:padding="8dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tv_active_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="當前狀態：待命中 (隨時可點擊卡片播放劇本)"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#00695C" />
    </LinearLayout>

    <!-- 主劇本卡片滾動區 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- 左欄：管家模式 (5 套) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingEnd="6dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🎩 管家模式劇本 (Butler Suite)"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#0277BD"
                    android:padding="6dp"
                    android:background="#E1F5FE"
                    android:layout_marginBottom="6dp" />

                <!-- 卡片容器 -->
                <LinearLayout
                    android:id="@+id/container_butler_cards"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- 右欄：詐騙警告 (5 套) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="6dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🚨 詐騙警告劇本 (Anti-Fraud Suite)"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#C62828"
                    android:padding="6dp"
                    android:background="#FFEBEE"
                    android:layout_marginBottom="6dp" />

                <!-- 卡片容器 -->
                <LinearLayout
                    android:id="@+id/container_fraud_cards"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
